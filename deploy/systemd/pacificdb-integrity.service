[Unit]
Description=PacificDB replica logical-integrity check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pacificdb-integrity
Group=pacificdb-integrity
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node /usr/lib/pacificdb/replica-integrity-monitor.mjs --config /etc/pacificdb/integrity-monitor.json --output /var/lib/pacificdb/integrity/result.json --prometheus /var/lib/pacificdb/integrity/result.prom
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pacificdb/integrity
UMask=0077
