{
  "name": "pacificdb-community",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pacificdb-community",
      "workspaces": [
        "sdk/node",
        "cli"
      ]
    },
    "cli": {
      "name": "@pacificdb/cli",
      "version": "0.1.0-beta.1",
      "license": "Apache-2.0",
      "dependencies": {
        "@pacificdb/client": "0.1.0-beta.1"
      },
      "bin": {
        "pacificdb": "bin/pacificdb.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@pacificdb/cli": {
      "resolved": "cli",
      "link": true
    },
    "node_modules/@pacificdb/client": {
      "resolved": "sdk/node",
      "link": true
    },
    "sdk/node": {
      "name": "@pacificdb/client",
      "version": "0.1.0-beta.1",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
