# PacificDB Community development configuration.
# Production requires absolute paths, TLS/mTLS, authentication, RBAC, audit logs,
# encrypted storage evidence, durable WAL settings, and RF3 quorum.
PACIFICDB_ENVIRONMENT=development
RAFT_CLUSTER_ID=pacificdb-community
RAFT_NODE_ID=node-1
DATA_ROOT=/var/lib/pacificdb/data
BACKUP_ROOT=/var/lib/pacificdb/backup
RESTORE_DIR=/var/lib/pacificdb/restore
WAL_DIR=/var/lib/pacificdb/data/wal
SST_DIR=/var/lib/pacificdb/data/sst
SNAPSHOT_DIR=/var/lib/pacificdb/data/snapshots
TMP_DIR=/var/lib/pacificdb/data/tmp
LOG_DIR=/var/lib/pacificdb/data/logs
ENGINE_HOST=127.0.0.1
ENGINE_BIND_HOST=127.0.0.1
ENGINE_PORT=9000
RAFT_LISTEN_HOST=127.0.0.1
RAFT_BIND_HOST=127.0.0.1
RAFT_LISTEN_PORT=9001
RAFT_PEERS=
RAFT_IS_LEADER=true
RAFT_LEADER_ELIGIBLE=true
MIN_QUORUM_SIZE=1
RAFT_REPLICATION_MODE=sync
RAFT_ELECTION_TIMEOUT_MS=3000
RAFT_HEARTBEAT_INTERVAL_MS=1000
WAL_ENABLED=true
WAL_FSYNC_ENABLED=true
WAL_FLUSH_ON_COMMIT=true
WAL_CHECKSUM_ENABLED=true
TLS_ENABLED=false
ENGINE_AUTH_REQUIRED=false
RBAC_ENABLED=true
API_KEYS_ENABLED=true
AUDIT_LOGGING_ENABLED=true
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
