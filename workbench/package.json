{
  "name": "pacificdb-workbench",
  "version": "0.1.0",
  "description": "PacificDB Workbench — Desktop database administration GUI for PacificDB Community Edition",
  "main": "dist-electron/main.js",
  "author": "PacificDB Community",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc --project tsconfig.node.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.node.json",
    "package": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src electron --ext .ts,.tsx"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.7",
    "@uiw/codemirror-theme-vscode": "^4.23.10",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.0",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-virtuoso": "^4.7.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.pacificdb.workbench",
    "productName": "PacificDB Workbench",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
