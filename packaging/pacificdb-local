#!/bin/sh
set -eu

case "$(uname -s)" in
  Darwin) default_home="$HOME/Library/Application Support/PacificDB" ;;
  *) default_home="${XDG_DATA_HOME:-$HOME/.local/share}/pacificdb" ;;
esac

PACIFICDB_HOME="${PACIFICDB_HOME:-$default_home}"
export PACIFICDB_ENVIRONMENT="${PACIFICDB_ENVIRONMENT:-development}"
export DATA_ROOT="${DATA_ROOT:-$PACIFICDB_HOME/data}"
export BACKUP_ROOT="${BACKUP_ROOT:-$PACIFICDB_HOME/backup}"
export RESTORE_DIR="${RESTORE_DIR:-$PACIFICDB_HOME/restore}"
export ENGINE_BIND_HOST="${ENGINE_BIND_HOST:-127.0.0.1}"
export ENGINE_AUTH_REQUIRED="${ENGINE_AUTH_REQUIRED:-0}"
export RAFT_CLUSTER_ID="${RAFT_CLUSTER_ID:-pacificdb-local}"
export RAFT_NODE_ID="${RAFT_NODE_ID:-node-1}"
export RAFT_IS_LEADER="${RAFT_IS_LEADER:-1}"
export MIN_QUORUM_SIZE="${MIN_QUORUM_SIZE:-1}"
export ENGINE_CPU_CORES="${ENGINE_CPU_CORES:-2}"
export CONN_MIN_THREADS="${CONN_MIN_THREADS:-4}"
export CONN_MAX_THREADS="${CONN_MAX_THREADS:-64}"
export CONN_MAX_QUEUE="${CONN_MAX_QUEUE:-2048}"
export MAX_CONNECTIONS="${MAX_CONNECTIONS:-256}"
export ADAPTIVE_ADMISSION="${ADAPTIVE_ADMISSION:-0}"
export ENGINE_KEEPALIVE_MAX_REQUESTS="${ENGINE_KEEPALIVE_MAX_REQUESTS:-1}"
export DBQ_SHARDS="${DBQ_SHARDS:-4}"
export DBQ_WORKERS_PER_SHARD="${DBQ_WORKERS_PER_SHARD:-2}"
export DBQ_MAX_QUEUE_PER_SHARD="${DBQ_MAX_QUEUE_PER_SHARD:-2048}"

mkdir -p "$DATA_ROOT" "$BACKUP_ROOT" "$RESTORE_DIR"
exec "$(dirname "$0")/db_engine" "$@"
