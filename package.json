{
  "name": "pacificdb-community",
  "version": "1.1.2",
  "private": true,
  "workspaces": [
    "sdk/node",
    "cli"
  ],
  "scripts": {
    "test:npm": "npm test --workspace @pacificdb/client && npm test --workspace @pacificdb/cli",
    "test:build-tools": "node scripts/patch-build-tool-compat.mjs && node --test scripts/test-build-tool-compat.mjs && node scripts/check-build-tool-advisories.mjs",
    "workbench": "node cli/bin/pacificdb.js workbench",
    "test:workbench:browser": "node scripts/test-workbench-browser.mjs",
    "workbench:desktop": "electron desktop/main.mjs",
    "desktop:prepare": "node scripts/patch-build-tool-compat.mjs && node scripts/prepare-workbench-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs",
    "desktop:unpacked": "npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --dir",
    "test:workbench:desktop": "node scripts/test-workbench-desktop.mjs"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
